# Custome-X Backend Environment Configuration Template
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Connection URL (PostgreSQL 16 + pgvector)
# SQLAlchemy async connection URL:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres

# Supabase Project Config & Auth
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=[YOUR-SUPABASE-ANON-KEY]
SUPABASE_JWT_SECRET=[YOUR-SUPABASE-JWT-SECRET-MIN-32-CHARS]

# Google Gemini API Config
GEMINI_API_KEY=[YOUR-GEMINI-API-KEY]
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.0-flash

# Autonomous Safeguards & Limits
REFUND_AUTONOMOUS_THRESHOLD_CENTS=5000
RETURN_WINDOW_DAYS=30
